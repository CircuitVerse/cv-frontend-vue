{
  "compilerOptions": {
    "target": "esnext",
    "module": "esnext",
    "moduleResolution": "bundler",
    "strict": false,
    "noImplicitAny": false,
    "allowJs": true,
    "checkJs": false,
    "skipLibCheck": true,
    "noEmit": true,
    "esModuleInterop": true,
    "lib": ["esnext", "dom", "dom.iterable"],
    "jsx": "preserve",
    "baseUrl": ".",
    "paths": {
      "#/*": ["./v1/src/*"]
    }
  },
  "include": [
    "v1/src/simulator/src/**/*",
    "v1/src/store/**/*",
    "v1/src/globalVariables.ts"
  ]
}
